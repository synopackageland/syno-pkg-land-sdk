 "cases": [
  {
   "name": "accepted",
   "patch": {}
  },
  {
   "name": "ctl must be exposed or hidden",
   "patch": {
    "notes.list": {
     "ctl": "public"
    }
   },
   "operation": "notes.list",
   "message": "ctl must be exposed or hidden"
  },
  {
   "name": "ctl exposed on a hidden operation",
   "patch": {
    "ctl.notes.list": {
     "ctl": "exposed"
    }
   },
   "operation": "ctl.notes.list",
   "message": "ctl cannot expose a hidden operation"
  },
  {
   "name": "gateway missing",
   "patch": {
    "notes.list": {
     "gateway": "ctl.notes.none"
    }
   },
   "operation": "notes.list",
   "message": "gateway must name another registered operation"
  },
  {
   "name": "gateway names itself",
   "patch": {
    "notes.list": {
     "gateway": "notes.list"
    }
   },
   "operation": "notes.list",
   "message": "gateway must name another registered operation"
  },
  {
   "name": "gateway not hidden",
   "patch": {
    "ctl.notes.list": {
     "ai": "human-only"
    }
   },
   "operation": "notes.list",
   "message": "gateway must name a hidden invoke operation without its own gateway"
  },
  {
   "name": "gateway not invoke",
   "patch": {
    "ctl.notes.list": {
     "flow": {
      "type": "ndjson",
      "method": "ctl.notes.list"
     }
    }
   },
   "operation": "notes.list",
   "message": "gateway must name a hidden invoke operation without its own gateway"
  },
  {
   "name": "gateway permission differs",
   "patch": {
    "ctl.notes.list": {
     "permission": "authenticated"
    }
   },
   "operation": "notes.list",
   "message": "gateway must name an operation with the same permission"
  },
  {
   "name": "gateway weaker effect",
   "patch": {
    "ctl.notes.save": {
     "effect": "read"
    }
   },
   "operation": "notes.save",
   "message": "gateway effect must be at least the operation's effect"
  },
  {
   "name": "gateway audit differs",
   "patch": {
    "ctl.notes.list": {
     "audit": "sensitive-read"
    }
   },
   "operation": "notes.list",
   "message": "gateway audit must equal the operation's audit class"
  },
  {
   "name": "gateway shared by two operations",
   "patch": {
    "rows.read": {
     "gateway": "ctl.notes.list"
    }
   },
   "operation": "rows.read",
   "message": "gateway serves only one operation"
  },
  {
   "name": "gateway of a ctl hidden operation",
   "patch": {
    "notes.list": {
     "ctl": "hidden"
    }
   },
   "operation": "notes.list",
   "message": "gateway applies only to an operation exposed to ctl"
  },
  {
   "name": "gateway on a hidden operation",
   "patch": {
    "notes.purge": {
     "ai": "hidden",
     "gateway": "rows.read"
    }
   },
   "operation": "notes.purge",
   "message": "gateway applies only to an operation exposed to ctl"
  },
  {
   "name": "sensitive-read audit on destructive",
   "patch": {
    "notes.purge": {
     "audit": "sensitive-read"
    }
   }
  },
  {
   "name": "read audit on a write",
   "patch": {
    "notes.purge": {
     "audit": "read"
    }
   },
   "operation": "notes.purge",
   "message": "audit of a change must be change or sensitive-read"
  },
  {
   "name": "none audit on a write",
   "patch": {
    "notes.export": {
     "audit": "none"
    }
   },
   "operation": "notes.export",
   "message": "audit of a change must be change or sensitive-read"
  }
 ]
