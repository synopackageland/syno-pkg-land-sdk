{
  "upstreamAuthPaths": [
    "/api/"
  ],
  "format": "synopkgland.http-inventory",
  "version": 1,
  "package": {
    "id": "ExampleApp",
    "version": "1.0.0-1",
    "displayName": "Example App"
  },
  "entry": "policy",
  "entryPolicyDigest": "1fd1fd51f2f3ffeab66d37c5b16b59247c91c3721099f01023f61fcd48306c75",
  "basePath": "/synopkgland/ExampleApp/",
  "registrySha256": "bdf96ef77f0bf3428c8966d75cf1d140f7105ff8be43f845b2593920f8ebffd6",
  "authSha256": "e096c2fe31ce5ae39083812815d0248c165fd986b3595491e3c51ed9956d818d",
  "bindings": {
    "documents.list": {
      "effect": "read",
      "permission": "authenticated",
      "kind": "rpc",
      "flow": {
        "type": "paginate-http",
        "method": "documents.list",
        "pagination": {
          "mode": "page",
          "pageParam": "page",
          "sizeParam": "page_size",
          "items": "/results",
          "next": "/next",
          "pageSize": 25,
          "maxPages": 40,
          "maxItems": 1000,
          "maxBytes": 16777216
        }
      },
      "http": {
        "method": "GET",
        "path": "/api/documents/",
        "query": {
          "ordering": {
            "literal": "id"
          }
        },
        "headers": {
          "Accept": "application/json; version=10"
        },
        "response": {
          "statuses": [
            200
          ],
          "decode": "json",
          "maxBytes": 1048576,
          "contentTypes": [
            "application/json"
          ]
        }
      }
    },
    "documents.upload": {
      "effect": "write",
      "permission": "authenticated",
      "kind": "stream",
      "flow": {
        "type": "upload-http",
        "method": "documents.upload",
        "fileParam": "file",
        "encoding": "multipart",
        "part": "document",
        "maxBytes": 268435456,
        "contentTypes": [
          "application/pdf",
          "image/jpeg",
          "image/png"
        ]
      },
      "http": {
        "method": "POST",
        "path": "/api/documents/post_document/",
        "headers": {
          "Accept": "application/json; version=10"
        },
        "body": {
          "encoding": "form",
          "fields": {
            "title": {
              "param": "title"
            }
          }
        },
        "response": {
          "statuses": [
            200
          ],
          "decode": "json",
          "maxBytes": 65536,
          "contentTypes": [
            "application/json"
          ],
          "project": {
            "fields": {
              "taskId": ""
            }
          }
        }
      }
    },
    "documents.download": {
      "effect": "read",
      "permission": "authenticated",
      "kind": "stream",
      "flow": {
        "type": "download-file",
        "method": "documents.download",
        "outputParam": "output",
        "maxBytes": 268435456,
        "contentTypes": [
          "application/pdf",
          "image/jpeg",
          "image/png",
          "application/octet-stream"
        ]
      },
      "http": {
        "method": "GET",
        "path": "/api/documents/{id}/download/",
        "query": {
          "original": {
            "literal": "true"
          }
        },
        "response": {
          "statuses": [
            200
          ],
          "decode": "binary",
          "maxBytes": 268435456,
          "contentTypes": [
            "application/pdf",
            "image/jpeg",
            "image/png",
            "application/octet-stream"
          ]
        }
      }
    }
  }
}
