{
  "name": "synopkgland-sdk-checks",
  "private": true,
  "scripts": {
    "check:docs": "node --test scripts/check-doc-versions.test.mjs && node scripts/check-doc-versions.mjs",
    "gates": "bash scripts/gate.sh",
    "gates:full": "bash scripts/gate.sh --full",
    "gates:fast": "bash scripts/gate.sh",
    "build": "npm --prefix node run build && npm --prefix ts run build"
  }
}
