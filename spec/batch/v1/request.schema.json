{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTTP batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "calls"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "calls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method"
        ],
        "properties": {
          "method": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "params": {}
        }
      }
    }
  }
}
