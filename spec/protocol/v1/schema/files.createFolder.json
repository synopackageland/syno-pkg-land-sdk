{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synopackageland/syno-pkg-land-sdk/spec/protocol/v1/schema/files.createFolder.json",
  "title": "files.createFolder",
  "description": "Create a folder; parents creates missing ancestors in scope.",
  "since": "0.9.0",
  "auth": "optional",
  "type": "object",
  "properties": {
    "delegation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "parents": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "delegation_id",
    "job_id",
    "path",
    "name"
  ]
}
