{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synopackageland/syno-pkg-land-sdk/spec/protocol/v1/schema/files.cancelOperation.json",
  "title": "files.cancelOperation",
  "description": "Cancel an asynchronous operation.",
  "since": "0.9.0",
  "auth": "optional",
  "type": "object",
  "properties": {
    "delegation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "delegation_id",
    "job_id"
  ]
}
