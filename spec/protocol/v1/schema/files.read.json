{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synopackageland/syno-pkg-land-sdk/spec/protocol/v1/schema/files.read.json",
  "title": "files.read",
  "description": "Copy a file into staging as the delegated user.",
  "since": "0.9.0",
  "auth": "optional",
  "type": "object",
  "properties": {
    "delegation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    }
  },
  "additionalProperties": false,
  "required": [
    "delegation_id",
    "job_id",
    "path"
  ]
}
