{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synopackageland/syno-pkg-land-sdk/spec/protocol/v1/schema/delegate.create.json",
  "title": "delegate.create",
  "description": "Create a time-limited grant (job_id, ttl_seconds) or an until-revoked destination grant (destination, lifetime). Since 0.11.0: ops [webapi.call], scope is a named WebAPI profile, omit path/destination; job_id + ttl_seconds or lifetime until-revoked.",
  "since": "0.9.0",
  "auth": "required",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(files\\.|webapi\\.call$)"
      }
    },
    "scope": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2592000
    },
    "destination": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "lifetime": {
      "const": "until-revoked"
    }
  },
  "additionalProperties": false,
  "required": [
    "ops",
    "scope"
  ]
}
