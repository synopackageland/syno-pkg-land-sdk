{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synopackageland/syno-pkg-land-sdk/spec/protocol/v1/schema/files.moveFromStaging.json",
  "title": "files.moveFromStaging",
  "description": "Admit an asynchronous move from staging into an until-revoked destination.",
  "since": "0.9.0",
  "auth": "optional",
  "type": "object",
  "properties": {
    "delegation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "staging": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 17179869184
    },
    "conflict": {
      "enum": [
        "fail",
        "overwrite",
        "rename"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "delegation_id",
    "job_id",
    "staging",
    "name",
    "size"
  ]
}
